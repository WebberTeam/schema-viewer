{
  "name": "@webberproject/schema-viewer",
  "version": "0.1.0",
  "description": "Interactive database schema viewer and editor. Renders ER diagrams from JSON with zoom, pan, editing, SQL import, and export. Derived from DrawDB (AGPL-3.0).",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./components": "./src/components/index.js",
    "./utils/*": "./src/utils/*.js"
  },
  "files": [
    "src/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:embed": "vite build --config vite.embed.config.js",
    "deploy": "npm run build:embed && gh-pages -d dist-embed",
    "prepublishOnly": "echo 'Ready to publish'",
    "preview": "vite preview"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "nanoid": "^5.1.11",
    "node-sql-parser": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "gh-pages": "^6.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  },
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/WebberTeam/schema-viewer.git"
  },
  "keywords": [
    "schema",
    "viewer",
    "erd",
    "database",
    "diagram",
    "svg"
  ]
}
